# Copier ce fichier en .env puis adapter.
# Clé secrète : sessions + chiffrement des jetons d'API stockés en base. À générer une fois :
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-moi
# URL publique de l'application (liens dans les SMS, webhooks Getaround)
BASE_URL=http://raspberrypi.local:8000
# Dossier des données (base SQLite, photos, contraventions, logos)
DATA_DIR=/data
TZ=Europe/Paris
# Autoriser la création de nouveaux comptes société depuis la page de connexion
ALLOW_SIGNUP=true
# Cookies "Secure" (mettre true derrière HTTPS)
COOKIE_SECURE=false
# Modèle Claude utilisé par l'assistant et la lecture des contraventions
CLAUDE_MODEL=claude-opus-5-5
# Derrière un proxy inverse (Caddy, nginx, tunnel) : adresses autorisées à transmettre l'IP réelle du visiteur
# FORWARDED_ALLOW_IPS=172.17.0.1
