# Alternative à Docker : service systemd.
#   sudo cp deploy/sharedfleet.service /etc/systemd/system/ && sudo systemctl enable --now sharedfleet
[Unit]
Description=SharedFleet
After=network-online.target
Wants=network-online.target

[Service]
User=pi
WorkingDirectory=/home/pi/SharedFleet
EnvironmentFile=/home/pi/SharedFleet/.env
ExecStart=/home/pi/SharedFleet/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000 --proxy-headers
Restart=on-failure

[Install]
WantedBy=multi-user.target
